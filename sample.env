## Set to the path of the TIM_Tools directory
PYTHONPATH=

## Docker Compose Profiles
## Comma-separated list of profiles to enable specific translator services
## Available profiles: wzdx, road-conditions, planned-events, vsl, signs, incident, weather-stations, redis, all
## Examples:
##   COMPOSE_PROFILES=incident                    # Run only Incident translator
##   COMPOSE_PROFILES=incident,wzdx               # Run Incident and WZDx translators (with Redis)
##   COMPOSE_PROFILES=all                         # Run all translators
COMPOSE_PROFILES=all